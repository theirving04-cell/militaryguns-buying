<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Global Conflict: HTTPS Edition</title>
    <style>
        :root { --army-green: #4b5320; --sand: #c2b280; --dark: #1a1a1a; }
        body { margin: 0; background: var(--dark); color: white; font-family: 'Segoe UI', Tahoma, sans-serif; overflow: hidden; }
        
        /* SCREEN SWITCHING LOGIC */
        .screen { display: none; width: 100vw; height: 100vh; }
        .active { display: flex; }

        /* BASE / SHOP SCREEN */
        #base-screen { flex-direction: column; align-items: center; background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('https://images.unsplash.com/photo-1580136608260-42d1c49e6a75?auto=format&fit=crop&q=80&w=1000'); background-size: cover; }
        .shop-container { display: flex; gap: 20px; margin-top: 50px; }
        .card { background: rgba(255,255,255,0.1); padding: 20px; border: 2px solid var(--army-green); border-radius: 10px; text-align: center; width: 200px; backdrop-filter: blur(5px); }
        .card h3 { color: var(--sand); }
        .btn { background: var(--army-green); color: white; border: none; padding: 15px 30px; cursor: pointer; font-weight: bold; margin-top: 10px; transition: 0.3s; }
        .btn:hover { background: #6b7330; transform: scale(1.05); }
        .btn:disabled { background: #333; cursor: not-allowed; }

        /* COMBAT SCREEN */
        #combat-screen { position: relative; background: #2c3e50; }
        canvas { background: #34495e; cursor: crosshair; }
        #combat-ui { position: absolute; top: 20px; left: 20px; pointer-events: none; }
    </style>
</head>
<body>

    <div id="base-screen" class="screen active">
        <h1 style="font-size: 3rem; color: var(--sand); margin-top: 50px;">COMMAND CENTER</h1>
        <div style="font-size: 1.5rem;">Global Funds: $<span id="base-money">0</span></div>
        
        <div class="shop-container">
            <div class="card">
                <h3>M4 CARBINE</h3>
                <p>Standard issue. Fast fire.</p>
                <p><b>$500</b></p>
                <button class="btn" id="buy-m4" onclick="buyGun('M4', 500)">PURCHASE</button>
            </div>
            <div class="card">
                <h3>AWP SNIPER</h3>
                <p>One shot, one kill.</p>
                <p><b>$1500</b></p>
                <button class="btn" id="buy-awp" onclick="buyGun('AWP', 1500)">PURCHASE</button>
            </div>
            <div class="card">
                <h3>REINFORCEMENTS</h3>
                <p>Full Health Pack</p>
                <p><b>$100</b></p>
                <button class="btn" id="buy-hp" onclick="buyHP()">HEAL</button>
            </div>
        </div>

        <div style="margin-top: 50px;">
            <p>Current Weapon: <strong id="current-weapon">Pistol</strong></p>
            <button class="btn" style="background: #c0392b; font-size: 1.5rem;" onclick="startMission()">DEPLOY TO FRONT LINES</button>
        </div>
    </div>

    <div id="combat-screen" class="screen">
        <div id="combat-ui">
            <div style="font-size: 24px; color: #2ecc71;">HP: <span id="combat-hp">100</span></div>
            <div style="font-size: 24px; color: #f1c40f;">EARNINGS: $<span id="combat-money">0</span></div>
            <button class="btn" style="pointer-events: all;" onclick="evacuate()">EVACUATE (SAVE PROGRESS)</button>
        </div>
        <canvas id="gameCanvas"></canvas>
    </div>

    <script>
        // --- GAME DATA ---
        let state = {
            money: 0,
            hp: 100,
            weapon: 'Pistol',
            inventory: ['Pistol'],
            inCombat: false
        };

        const weapons = {
            'Pistol': { rate: 500, dmg: 25, color: '#bdc3c7' },
            'M4': { rate: 120, dmg: 30, color: '#2ecc71' },
            'AWP': { rate: 1200, dmg: 150, color: '#e74c3c' }
        };

        // --- SHOP LOGIC ---
        function updateBaseUI() {
            document.getElementById('base-money').innerText = state.money;
            document.getElementById('current-weapon').innerText = state.weapon;
            document.getElementById('buy-m4').disabled = (state.money < 500 || state.inventory.includes('M4'));
            document.getElementById('buy-awp').disabled = (state.money < 1500 || state.inventory.includes('AWP'));
        }

        function buyGun(name, cost) {
            if (state.money >= cost) {
                state.money -= cost;
                state.weapon = name;
                state.inventory.push(name);
                updateBaseUI();
                alert(name + " Equipped!");
            }
        }

        function buyHP() {
            if (state.money >= 100) {
                state.money -= 100;
                state.hp = 100;
                updateBaseUI();
                alert("Soldier Healed!");
            }
        }

        // --- TRANSITION LOGIC ---
        function startMission() {
            document.getElementById('base-screen').classList.remove('active');
            document.getElementById('combat-screen').classList.add('active');
            state.inCombat = true;
            initCombat();
        }

        function evacuate() {
            state.inCombat = false;
            document.getElementById('combat-screen').classList.remove('active');
            document.getElementById('base-screen').classList.add('active');
            updateBaseUI();
        }

        // --- COMBAT ENGINE (Canvas) ---
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        let player = { x: 0, y: 0, angle: 0 };
        let bullets = [];
        let enemies = [];
        let lastShot = 0;
        let keys = {};

        function initCombat() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
            player.x = canvas.width / 2;
            player.y = canvas.height / 2;
            enemies = [];
            bullets = [];
            requestAnimationFrame(gameLoop);
        }

        window.addEventListener('keydown', e => keys[e.key.toLowerCase()] = true);
        window.addEventListener('keyup', e => keys[e.key.toLowerCase()] = false);
        window.addEventListener('mousemove', e => {
            player.angle = Math.atan2(e.clientY - player.y, e.clientX - player.x);
        });
        window.addEventListener('mousedown', () => {
            if (!state.inCombat) return;
            let now = Date.now();
            let config = weapons[state.weapon];
            if (now - lastShot > config.rate) {
                bullets.push({ x: player.x, y: player.y, a: player.angle, d: config.dmg });
                lastShot = now;
            }
        });

        function gameLoop() {
            if (!state.inCombat) return;

            // Movement
            if (keys['w']) player.y -= 4;
            if (keys['s']) player.y += 4;
            if (keys['a']) player.x -= 4;
            if (keys['d']) player.x += 4;

            // Clear Screen
            ctx.fillStyle = "#34495e";
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Draw Player
            ctx.save();
            ctx.translate(player.x, player.y);
            ctx.rotate(player.angle);
            ctx.fillStyle = "#4b5320"; // Army Green
            ctx.fillRect(-20, -20, 40, 40);
            ctx.fillStyle = "black";
            ctx.fillRect(10, -5, 25, 10);
            ctx.restore();

            // Bullets
            bullets.forEach((b, i) => {
                b.x += Math.cos(b.a) * 12;
                b.y += Math.sin(b.a) * 12;
                ctx.fillStyle = "yellow";
                ctx.beginPath(); ctx.arc(b.x, b.y, 3, 0, Math.PI*2); ctx.fill();
                if (b.x < 0 || b.x > canvas.width) bullets.splice(i, 1);
            });

            // Enemies
            if (Math.random() < 0.03) {
                enemies.push({ x: Math.random()*canvas.width, y: -50, hp: 60 });
            }

            enemies.forEach((en, i) => {
                let dx = player.x - en.x;
                let dy = player.y - en.y;
                let dist = Math.sqrt(dx*dx + dy*dy);
                en.x += dx/dist * 2;
                en.y += dy/dist * 2;

                ctx.fillStyle = "#c0392b";
                ctx.fillRect(en.x - 15, en.y - 15, 30, 30);

                if (dist < 30) {
                    state.hp -= 0.2;
                    document.getElementById('combat-hp').innerText = Math.floor(state.hp);
                    if (state.hp <= 0) {
                        alert("Killed in Action! Losing gear...");
                        location.reload();
                    }
                }

                bullets.forEach((b, bi) => {
                    let bdx = b.x - en.x;
                    let bdy = b.y - en.y;
                    if (Math.sqrt(bdx*bdx + bdy*bdy) < 20) {
                        en.hp -= b.d;
                        bullets.splice(bi, 1);
                        if (en.hp <= 0) {
                            enemies.splice(i, 1);
                            state.money += 50;
                            document.getElementById('combat-money').innerText = state.money;
                        }
                    }
                });
            });

            requestAnimationFrame(gameLoop);
        }

        updateBaseUI();
    </script>
</body>
</html>
